# Ghost subject (subject_id `ghost`) - append to the repository .env and
# `set -a; source .env; set +a` before any uisemtest entry point.
#
# Every value below is a throwaway local-only value: the container is bound to
# 127.0.0.1:18093, the mailer is the nodemailer stub transport (nothing leaves
# the machine) and the whole content directory is discarded on every reset.
# Real credentials are never stored in this repository; the adapter and the
# profile only ever name these variables.
#
# NOTE: values must not contain spaces.  The repository convention is
# `set -a; . ./.env; set +a`, and an unquoted value with a space is parsed as a
# command by zsh (observed 2026-09-20 while wiring this subject up).

# Instance key of the docker_single adapter (the container name is derived from
# it) and the study output root of this subject.
UISEMTEST_GHOST_OUTPUT_ROOT=<REPO_ROOT>/eval/ui_semantics/ghost-20260921

# Absolute host directory holding Ghost's content directory (SQLite database,
# uploaded images, routes.yaml, members key pair) and the golden snapshot.
# It must be OUTSIDE the repository: deploy/ghost/materialize.sh rebuilds it.
UISEMTEST_GHOST_RUNTIME_ROOT=/tmp/uisemtest-ghost

# Optional overrides.  The lifecycle scripts fall back to the port the adapter
# publishes and to the default container prefix, because the RECORDING entry
# point runs profile.reset.command with the plain shell environment (no adapter
# runtime.environment) and therefore has to work with .env alone.
# UISEMTEST_GHOST_BASE_URL=http://127.0.0.1:18093
# UISEMTEST_GHOST_CONTAINER_PREFIX=uisemtest-ghost
# UISEMTEST_GHOST_READY_TIMEOUT_S=120

# Publication title used by POST /ghost/api/admin/authentication/setup/.
UISEMTEST_GHOST_SITE_TITLE=UISemTest-Ghost

# actor_a is the installation OWNER created by the setup endpoint.
UISEMTEST_GHOST_ACTOR_A_NAME=ActorA
UISEMTEST_GHOST_ACTOR_A_EMAIL=actora@ghost.invalid
UISEMTEST_GHOST_ACTOR_A_PASSWORD=<28 random alphanumerics, generated locally>

# actor_b is a staff account created through the invitation flow: the owner
# posts an invite, deploy/ghost/seed.sh reads the token out of the instance's
# own `invites` table and redeems it through
# POST /ghost/api/admin/authentication/invitation/.  No mailbox is involved.
UISEMTEST_GHOST_ACTOR_B_NAME=ActorB
UISEMTEST_GHOST_ACTOR_B_EMAIL=actorb@ghost.invalid
UISEMTEST_GHOST_ACTOR_B_PASSWORD=<28 random alphanumerics, generated locally>
# Name of the Ghost role actor_b receives; resolved against GET /ghost/api/admin/roles/.
UISEMTEST_GHOST_ACTOR_B_ROLE=Author
