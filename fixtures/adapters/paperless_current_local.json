{
  "schema_version": "uisemtest-current-subject-adapter-v1",
  "adapter_id": "paperless-current-local-http-v1",
  "subject_id": "paperless",
  "runtime": {
    "kind": "local_http",
    "source_root": "${UISEMTEST_REPO_ROOT}",
    "environment": {
      "PATH": "${UISEMTEST_OPERATOR_PATH}",
      "PYTHONPATH": "${UISEMTEST_REPO_ROOT}/src",
      "NO_PROXY": "localhost,127.0.0.1,::1",
      "no_proxy": "localhost,127.0.0.1,::1",
      "UISEMTEST_PYTHON": "${UISEMTEST_PYTHON}",
      "UISEMTEST_REPO_ROOT": "${UISEMTEST_REPO_ROOT}",
      "UISEMTEST_OPERATOR_PATH": "${UISEMTEST_OPERATOR_PATH}",
      "UISEMTEST_DOCKER_SINGLE_ADAPTER": "${UISEMTEST_REPO_ROOT}/fixtures/adapters/paperless_current_local.json",
      "UISEMTEST_PAPERLESS_OUTPUT_ROOT": "${UISEMTEST_PAPERLESS_OUTPUT_ROOT}",
      "UISEMTEST_PAPERLESS_SECRET_KEY": "${UISEMTEST_PAPERLESS_SECRET_KEY}",
      "UISEMTEST_PAPERLESS_DBPASS": "${UISEMTEST_PAPERLESS_DBPASS}",
      "UISEMTEST_PAPERLESS_ACTOR_A_USERNAME": "${UISEMTEST_PAPERLESS_ACTOR_A_USERNAME}",
      "UISEMTEST_PAPERLESS_ACTOR_A_PASSWORD": "${UISEMTEST_PAPERLESS_ACTOR_A_PASSWORD}",
      "UISEMTEST_PAPERLESS_ACTOR_B_USERNAME": "${UISEMTEST_PAPERLESS_ACTOR_B_USERNAME}",
      "UISEMTEST_PAPERLESS_ACTOR_B_PASSWORD": "${UISEMTEST_PAPERLESS_ACTOR_B_PASSWORD}"
    },
    "materialize_commands": [[
      "/bin/bash",
      "${UISEMTEST_REPO_ROOT}/deploy/paperless/stack.sh",
      "sidecars-up"
    ]],
    "server_commands": [[
      "${UISEMTEST_PYTHON}",
      "-m",
      "subject_adapters.docker_single_local",
      "supervise"
    ]],
    "health_probes": [
      {"url": "http://127.0.0.1:18091/accounts/login/", "expect_status": 200},
      {"url": "http://127.0.0.1:18091/api/ui_settings/", "expect_status": 401}
    ],
    "teardown_generated_paths": [],
    "loopback_only": true,
    "reset_from_profile": true,
    "independent_arm_sessions": true
  },
  "docker_single": {
    "schema_version": "uisemtest-docker-single-runtime-v1",
    "container_name_prefix": "uisemtest-paperless",
    "instance_key_env": "UISEMTEST_PAPERLESS_OUTPUT_ROOT",
    "image": {
      "repository": "ghcr.io/paperless-ngx/paperless-ngx",
      "tag": "3.2.0",
      "digest": "sha256:22dc423ff48ac1629977dbf0c9625ba9f60d3bd1291a2ff173c65351984a14c2",
      "pull_policy": "if_absent"
    },
    "ports": [
      {"host": 18091, "container": 8000}
    ],
    "environment": {
      "PAPERLESS_URL": "http://127.0.0.1:18091",
      "PAPERLESS_PORT": "8000",
      "PAPERLESS_TIME_ZONE": "UTC",
      "PAPERLESS_SECRET_KEY": "${UISEMTEST_PAPERLESS_SECRET_KEY}",
      "PAPERLESS_DBENGINE": "postgresql",
      "PAPERLESS_DBHOST": "/var/run/postgresql",
      "PAPERLESS_DBNAME": "paperless",
      "PAPERLESS_DBUSER": "paperless",
      "PAPERLESS_DBPASS": "${UISEMTEST_PAPERLESS_DBPASS}",
      "PAPERLESS_REDIS": "unix:///var/run/redis/redis.sock",
      "PAPERLESS_OCR_LANGUAGE": "eng",
      "PAPERLESS_AI_ENABLED": "false",
      "PAPERLESS_ENABLE_UPDATE_CHECK": "false",
      "PAPERLESS_TASK_WORKERS": "1",
      "PAPERLESS_THREADS_PER_WORKER": "1",
      "PAPERLESS_WEBSERVER_WORKERS": "1",
      "UISEMTEST_PAPERLESS_ACTOR_A_USERNAME": "${UISEMTEST_PAPERLESS_ACTOR_A_USERNAME}",
      "UISEMTEST_PAPERLESS_ACTOR_A_PASSWORD": "${UISEMTEST_PAPERLESS_ACTOR_A_PASSWORD}",
      "UISEMTEST_PAPERLESS_ACTOR_B_USERNAME": "${UISEMTEST_PAPERLESS_ACTOR_B_USERNAME}",
      "UISEMTEST_PAPERLESS_ACTOR_B_PASSWORD": "${UISEMTEST_PAPERLESS_ACTOR_B_PASSWORD}"
    },
    "volumes": [
      {
        "kind": "named",
        "name": "data",
        "container_path": "/usr/src/paperless/data",
        "reset_scope": "fresh_on_reset"
      },
      {
        "kind": "named",
        "name": "media",
        "container_path": "/usr/src/paperless/media",
        "reset_scope": "fresh_on_reset"
      },
      {
        "kind": "named",
        "name": "golden",
        "container_path": "/usr/src/paperless/golden",
        "reset_scope": "fresh_on_reset"
      },
      {
        "kind": "named",
        "name": "pgsock",
        "container_path": "/var/run/postgresql",
        "reset_scope": "persistent"
      },
      {
        "kind": "named",
        "name": "redissock",
        "container_path": "/var/run/redis",
        "reset_scope": "persistent"
      },
      {
        "kind": "bind",
        "source": "${UISEMTEST_REPO_ROOT}/deploy/paperless/container",
        "container_path": "/opt/uisemtest",
        "read_only": true,
        "reset_scope": "persistent"
      }
    ],
    "readiness": {
      "probes": [
        {"url": "http://127.0.0.1:18091/accounts/login/", "expect_status": 200}
      ],
      "timeout_seconds": 300,
      "poll_interval_ms": 250
    },
    "reset": {
      "strategy": "run_script",
      "timeout_seconds": 90,
      "script": {
        "location": "container",
        "command": ["/bin/bash", "/opt/uisemtest/reset.sh"],
        "workdir": "/usr/src/paperless",
        "timeout_seconds": 60
      }
    },
    "seed": {
      "location": "container",
      "command": ["/bin/bash", "/opt/uisemtest/seed.sh"],
      "workdir": "/usr/src/paperless",
      "timeout_seconds": 600
    }
  },
  "request_mapping": {
    "mode": "current_recording_exact",
    "header_policy": "accept_content_type_only"
  },
  "request_bindings": {},
  "fresh_materialization_policy": {
    "source": "current_observed_value_flow_set",
    "selection": "exact_setup_to_candidate_consumers_v1",
    "allowed_target_locations": ["path", "query", "header", "body"],
    "allowed_scalar_types": ["string", "integer", "number", "boolean"]
  },
  "observer_policy": {
    "schema_version": "uisemtest-current-observer-policy-v1",
    "purity_domains_exact_set": ["cache", "cookie", "last_seen", "token"],
    "request_method_policy": "read_only"
  },
  "settle_policy": {
    "schema_version": "uisemtest-current-settle-policy-v2",
    "rule": "bounded_semantic_stability_v1",
    "minimum_duration_ms": 500,
    "poll_interval_ms": 100,
    "consecutive_identical_observations": 3,
    "maximum_duration_ms": 2000
  },
  "sensitive_classification": {
    "forbidden_source_refs": [],
    "forbidden_projection_paths": ["$.password", "$.token", "$.access_token"]
  }
}
