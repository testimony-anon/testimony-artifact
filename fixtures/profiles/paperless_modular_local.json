{
  "base_url": "http://127.0.0.1:18091",
  "auth": {
    "method": "none"
  },
  "actors": [
    {
      "actor_id": "actor_a",
      "auth": {
        "method": "cookie_session",
        "credentials_ref": {
          "email_env": "UISEMTEST_PAPERLESS_ACTOR_A_USERNAME",
          "password_env": "UISEMTEST_PAPERLESS_ACTOR_A_PASSWORD"
        },
        "probe_endpoint": {
          "method": "GET",
          "path": "/api/profile/",
          "expect_status": 200,
          "unauthenticated_status": 401,
          "expect_json_path": "$.email"
        },
        "cookie_session": {
          "method": "POST",
          "path": "/api/auth/headless/browser/v1/auth/login",
          "headers": {
            "Content-Type": "application/json"
          },
          "body_template": {
            "username": "${email}",
            "password": "${password}"
          },
          "cookie_name": "sessionid",
          "cookie_path": "/",
          "csrf": {
            "cookie_name": "csrftoken",
            "header_name": "X-CSRFToken"
          }
        }
      }
    },
    {
      "actor_id": "actor_b",
      "auth": {
        "method": "cookie_session",
        "credentials_ref": {
          "email_env": "UISEMTEST_PAPERLESS_ACTOR_B_USERNAME",
          "password_env": "UISEMTEST_PAPERLESS_ACTOR_B_PASSWORD"
        },
        "probe_endpoint": {
          "method": "GET",
          "path": "/api/profile/",
          "expect_status": 200,
          "unauthenticated_status": 401,
          "expect_json_path": "$.email"
        },
        "cookie_session": {
          "method": "POST",
          "path": "/api/auth/headless/browser/v1/auth/login",
          "headers": {
            "Content-Type": "application/json"
          },
          "body_template": {
            "username": "${email}",
            "password": "${password}"
          },
          "cookie_name": "sessionid",
          "cookie_path": "/",
          "csrf": {
            "cookie_name": "csrftoken",
            "header_name": "X-CSRFToken"
          }
        }
      }
    }
  ],
  "reset": {
    "command": [
      ".venv/bin/python",
      "-m",
      "subject_adapters.docker_single_local",
      "reset",
      "--adapter",
      "fixtures/adapters/paperless_current_local.json",
      "--output",
      "unused.json"
    ],
    "verify_request": {
      "method": "GET",
      "path": "/accounts/login/",
      "expect_status": 200
    }
  },
  "rate_limit": {
    "max_concurrency": 1,
    "min_interval_ms": 50,
    "retry_on_429": {
      "max_retries": 1
    }
  },
  "drive_mode": "replay"
}
