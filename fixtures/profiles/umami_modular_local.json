{
  "base_url": "http://127.0.0.1:18090",
  "auth": {
    "method": "none"
  },
  "actors": [
    {
      "actor_id": "actor_a",
      "auth": {
        "method": "api_token",
        "login_entry": "/login",
        "credentials_ref": {
          "email_env": "UISEMTEST_UMAMI_ACTOR_A_USERNAME",
          "password_env": "UISEMTEST_UMAMI_ACTOR_A_PASSWORD"
        },
        "token_scheme": "Bearer",
        "probe_endpoint": {
          "method": "POST",
          "path": "/api/auth/verify",
          "expect_status": 200,
          "unauthenticated_status": 401,
          "expect_json_path": "$.username"
        },
        "api_token": {
          "method": "POST",
          "path": "/api/auth/login",
          "headers": {
            "Content-Type": "application/json"
          },
          "body_template": {
            "username": "${email}",
            "password": "${password}"
          },
          "token_json_path": "$.token",
          "recording_activation": "api_then_inject",
          "browser_activation": {
            "storage": "local_storage",
            "key": "umami.auth",
            "value_template": "\"${token}\"",
            "entry_url": "/websites",
            "timeout_ms": 30000
          }
        },
        "logout_endpoint": {
          "method": "POST",
          "path": "/api/auth/logout"
        }
      }
    },
    {
      "actor_id": "actor_b",
      "auth": {
        "method": "api_token",
        "login_entry": "/login",
        "credentials_ref": {
          "email_env": "UISEMTEST_UMAMI_ACTOR_B_USERNAME",
          "password_env": "UISEMTEST_UMAMI_ACTOR_B_PASSWORD"
        },
        "token_scheme": "Bearer",
        "probe_endpoint": {
          "method": "POST",
          "path": "/api/auth/verify",
          "expect_status": 200,
          "unauthenticated_status": 401,
          "expect_json_path": "$.username"
        },
        "api_token": {
          "method": "POST",
          "path": "/api/auth/login",
          "headers": {
            "Content-Type": "application/json"
          },
          "body_template": {
            "username": "${email}",
            "password": "${password}"
          },
          "token_json_path": "$.token",
          "recording_activation": "api_then_inject",
          "browser_activation": {
            "storage": "local_storage",
            "key": "umami.auth",
            "value_template": "\"${token}\"",
            "entry_url": "/websites",
            "timeout_ms": 30000
          }
        },
        "logout_endpoint": {
          "method": "POST",
          "path": "/api/auth/logout"
        }
      }
    }
  ],
  "reset": {
    "command": [
      ".venv/bin/python",
      "-m",
      "subject_adapters.docker_single_local",
      "reset",
      "--adapter",
      "fixtures/adapters/umami_current_local.json",
      "--output",
      "unused.json"
    ],
    "verify_request": {
      "method": "GET",
      "path": "/api/heartbeat",
      "expect_status": 200,
      "expect_json_path": "$.ok",
      "expect_json_equals": true
    }
  },
  "rate_limit": {
    "max_concurrency": 1,
    "min_interval_ms": 50,
    "retry_on_429": {
      "max_retries": 1
    }
  },
  "drive_mode": "replay"
}
