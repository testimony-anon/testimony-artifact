{
  "base_url": "http://127.0.0.1:3001",
  "auth": {"method": "none"},
  "actors": [
    {
      "actor_id": "actor_a",
      "auth": {
        "method": "form_login",
        "login_entry": "/#/login",
        "credentials_ref": {
          "email_env": "UISEMTEST_CONDUIT_ACTOR_A_EMAIL",
          "password_env": "UISEMTEST_CONDUIT_ACTOR_A_PASSWORD"
        },
        "token_scheme": "Token",
        "probe_endpoint": {
          "method": "GET",
          "path": "/api/user",
          "expect_status": 200,
          "unauthenticated_status": 401,
          "expect_json_path": "$.user.username"
        },
        "api_token": {
          "method": "POST",
          "path": "/api/users/login",
          "headers": {"Content-Type": "application/json"},
          "body_template": {
            "user": {"email": "${email}", "password": "${password}"}
          },
          "token_json_path": "$.user.token"
        }
      }
    },
    {
      "actor_id": "actor_b",
      "auth": {
        "method": "form_login",
        "login_entry": "/#/login",
        "credentials_ref": {
          "email_env": "UISEMTEST_CONDUIT_ACTOR_B_EMAIL",
          "password_env": "UISEMTEST_CONDUIT_ACTOR_B_PASSWORD"
        },
        "token_scheme": "Token",
        "probe_endpoint": {
          "method": "GET",
          "path": "/api/user",
          "expect_status": 200,
          "unauthenticated_status": 401,
          "expect_json_path": "$.user.username"
        },
        "api_token": {
          "method": "POST",
          "path": "/api/users/login",
          "headers": {"Content-Type": "application/json"},
          "body_template": {
            "user": {"email": "${email}", "password": "${password}"}
          },
          "token_json_path": "$.user.token"
        }
      }
    }
  ],
  "reset": {
    "command": [
      ".venv/bin/python",
      "-m",
      "subject_adapters.conduit_local",
      "reset",
      "--output",
      "unused.json"
    ],
    "verify_request": {
      "method": "GET",
      "path": "/api/articles?limit=1&offset=0",
      "expect_status": 200,
      "expect_json_path": "$.articlesCount",
      "expect_json_equals": 0
    }
  },
  "rate_limit": {
    "max_concurrency": 1,
    "min_interval_ms": 50,
    "retry_on_429": {"max_retries": 1}
  },
  "drive_mode": "replay"
}
