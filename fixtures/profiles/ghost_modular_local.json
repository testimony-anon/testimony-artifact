{
  "base_url": "http://127.0.0.1:18093",
  "read_semantic_endpoints": [
    {
      "method": "POST",
      "path": "/ghost/api/admin/stats/posts-member-counts/"
    }
  ],
  "auth": {
    "method": "none"
  },
  "actors": [
    {
      "actor_id": "actor_a",
      "auth": {
        "method": "cookie_session",
        "credentials_ref": {
          "email_env": "UISEMTEST_GHOST_ACTOR_A_EMAIL",
          "password_env": "UISEMTEST_GHOST_ACTOR_A_PASSWORD"
        },
        "probe_endpoint": {
          "method": "GET",
          "path": "/ghost/api/admin/users/me/",
          "expect_status": 200,
          "unauthenticated_status": 403,
          "expect_json_path": "$.users[0].email"
        },
        "logout_endpoint": {
          "method": "DELETE",
          "path": "/ghost/api/admin/session/"
        },
        "cookie_session": {
          "method": "POST",
          "path": "/ghost/api/admin/session/",
          "headers": {
            "Content-Type": "application/json"
          },
          "body_template": {
            "username": "${email}",
            "password": "${password}"
          },
          "cookie_path": "/ghost"
        }
      }
    },
    {
      "actor_id": "actor_b",
      "auth": {
        "method": "cookie_session",
        "credentials_ref": {
          "email_env": "UISEMTEST_GHOST_ACTOR_B_EMAIL",
          "password_env": "UISEMTEST_GHOST_ACTOR_B_PASSWORD"
        },
        "probe_endpoint": {
          "method": "GET",
          "path": "/ghost/api/admin/users/me/",
          "expect_status": 200,
          "unauthenticated_status": 403,
          "expect_json_path": "$.users[0].email"
        },
        "logout_endpoint": {
          "method": "DELETE",
          "path": "/ghost/api/admin/session/"
        },
        "cookie_session": {
          "method": "POST",
          "path": "/ghost/api/admin/session/",
          "headers": {
            "Content-Type": "application/json"
          },
          "body_template": {
            "username": "${email}",
            "password": "${password}"
          },
          "cookie_path": "/ghost"
        }
      }
    }
  ],
  "reset": {
    "command": [
      ".venv/bin/python",
      "-m",
      "subject_adapters.docker_single_local",
      "reset",
      "--adapter",
      "fixtures/adapters/ghost_current_local.json",
      "--output",
      "unused.json"
    ],
    "verify_request": {
      "method": "GET",
      "path": "/ghost/api/admin/site/",
      "expect_status": 200,
      "expect_json_path": "$.site.version",
      "expect_json_equals": "5.130"
    }
  },
  "rate_limit": {
    "max_concurrency": 1,
    "min_interval_ms": 50,
    "retry_on_429": {
      "max_retries": 1
    }
  },
  "drive_mode": "replay"
}
