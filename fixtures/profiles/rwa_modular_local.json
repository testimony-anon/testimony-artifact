{
  "base_url": "http://localhost:14001",
  "auth": {"method": "none"},
  "actors": [
    {
      "actor_id": "actor_a",
      "auth": {
        "method": "cookie_session",
        "credentials_ref": {
          "email_env": "UISEMTEST_RWA_ACTOR_A_USERNAME",
          "password_env": "UISEMTEST_RWA_ACTOR_A_PASSWORD"
        },
        "probe_endpoint": {
          "method": "GET",
          "path": "/checkAuth",
          "expect_status": 200,
          "unauthenticated_status": 401,
          "expect_json_path": "$.user.username",
          "expect_json_equals": "Heath93"
        },
        "cookie_session": {
          "method": "POST",
          "path": "/login",
          "headers": {"Content-Type": "application/json"},
          "body_template": {
            "username": "${email}",
            "password": "${password}"
          },
          "cookie_name": "connect.sid",
          "cookie_path": "/",
          "browser_activation": {
            "entry_url": "http://localhost:14000/signin",
            "username_selector": "[data-test=signin-username] input",
            "password_selector": "[data-test=signin-password] input",
            "submit_selector": "[data-test=signin-submit]",
            "ready_selector": "[data-test=nav-top-new-transaction]",
            "timeout_ms": 30000
          }
        }
      }
    },
    {
      "actor_id": "actor_b",
      "auth": {
        "method": "cookie_session",
        "credentials_ref": {
          "email_env": "UISEMTEST_RWA_ACTOR_B_USERNAME",
          "password_env": "UISEMTEST_RWA_ACTOR_B_PASSWORD"
        },
        "probe_endpoint": {
          "method": "GET",
          "path": "/checkAuth",
          "expect_status": 200,
          "unauthenticated_status": 401,
          "expect_json_path": "$.user.username",
          "expect_json_equals": "Arvilla_Hegmann"
        },
        "cookie_session": {
          "method": "POST",
          "path": "/login",
          "headers": {"Content-Type": "application/json"},
          "body_template": {
            "username": "${email}",
            "password": "${password}"
          },
          "cookie_name": "connect.sid",
          "cookie_path": "/",
          "browser_activation": {
            "entry_url": "http://localhost:14000/signin",
            "username_selector": "[data-test=signin-username] input",
            "password_selector": "[data-test=signin-password] input",
            "submit_selector": "[data-test=signin-submit]",
            "ready_selector": "[data-test=nav-top-new-transaction]",
            "timeout_ms": 30000
          }
        }
      }
    }
  ],
  "reset": {
    "command": [
      ".venv/bin/python",
      "-m",
      "subject_adapters.rwa_local",
      "reset",
      "--output",
      "unused.json"
    ],
    "verify_request": {"method": "GET", "path": "/", "expect_status": 200}
  },
  "rate_limit": {
    "max_concurrency": 1,
    "min_interval_ms": 50,
    "retry_on_429": {"max_retries": 1}
  },
  "drive_mode": "replay"
}
