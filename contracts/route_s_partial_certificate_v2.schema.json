{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "route_s_partial_certificate_v2.schema.json",
  "title": "Route-S hash-chained write-through partial record v2",
  "type": "object",
  "required": ["schema_version", "certificate_status", "candidate_id", "record_sequence", "recorded_at", "previous_record_sha256", "last_closed_slot", "last_closed_artifact_ref", "last_closed_artifact_sha256", "protocol_slot_states", "outcome", "provider_calls", "live_result_eligible"],
  "properties": {
    "schema_version": {"const": "ui-semantics-route-s-partial-certificate-v2"},
    "certificate_status": {"const": "partial"},
    "candidate_id": {"type": "string", "minLength": 1},
    "record_sequence": {"type": "integer", "minimum": 0},
    "recorded_at": {"type": "string", "format": "date-time"},
    "previous_record_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha"}]},
    "last_closed_slot": {"enum": ["none", "Rc", "Sc", "Oc1", "settle_c", "Oc2", "Rt", "St", "Ot0", "P", "settle_t", "Ot1"]},
    "last_closed_artifact_ref": {"type": ["string", "null"]},
    "last_closed_artifact_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha"}]},
    "protocol_slot_states": {
      "type": "object", "additionalProperties": false,
      "required": ["Rc", "Sc", "Oc1", "settle_c", "Oc2", "Rt", "St", "Ot0", "P", "settle_t", "Ot1"],
      "properties": {
        "Rc": {"$ref": "#/$defs/state"}, "Sc": {"$ref": "#/$defs/state"}, "Oc1": {"$ref": "#/$defs/state"}, "settle_c": {"$ref": "#/$defs/state"}, "Oc2": {"$ref": "#/$defs/state"},
        "Rt": {"$ref": "#/$defs/state"}, "St": {"$ref": "#/$defs/state"}, "Ot0": {"$ref": "#/$defs/state"}, "P": {"$ref": "#/$defs/state"}, "settle_t": {"$ref": "#/$defs/state"}, "Ot1": {"$ref": "#/$defs/state"}
      }
    },
    "outcome": {"const": "pending"}, "provider_calls": {"const": 0}, "live_result_eligible": {"const": false}
  },
  "additionalProperties": false,
  "$defs": {"sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "state": {"enum": ["pending", "executed", "not_executed"]}}
}
