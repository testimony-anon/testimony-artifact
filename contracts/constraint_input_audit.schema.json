{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "constraint_input_audit.schema.json",
  "title": "constraint_input_audit — UI constraint input proposal and execution audit",
  "description": "Immutable Stage5 sidecar for every UI-constraint input proposal, its admission result, redacted live observations, and comparable execution classification.",
  "type": "object",
  "required": ["metadata", "proposal_runs", "observations", "candidates"],
  "properties": {
    "metadata": {
      "$ref": "metadata_envelope.schema.json",
      "properties": {
        "artifact_type": { "const": "constraint_input_audit" },
        "stage": { "const": "stage5" }
      }
    },
    "proposal_runs": { "type": "array", "items": { "$ref": "#/$defs/proposal_run" }, "x-unique-by": "proposal_run_id", "x-volatility": "volatile" },
    "observations": { "type": "array", "items": { "$ref": "#/$defs/observation" }, "x-unique-by": "record_id", "x-volatility": "volatile" },
    "candidates": { "type": "array", "items": { "$ref": "#/$defs/candidate" }, "x-unique-by": "candidate_id", "x-volatility": "structural" }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$" },
    "operation_id": { "type": "string", "pattern": "^(get|put|post|delete|options|head|patch|trace)_[a-z0-9_]+$" },
    "artifact_record_ref": {
      "type": "object",
      "required": ["artifact_type", "run_id", "record_id"],
      "properties": {
        "artifact_type": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "record_id": { "$ref": "#/$defs/identifier" }
      },
      "additionalProperties": false
    },
    "proposal_run": {
      "type": "object",
      "required": ["proposal_run_id", "prompt_sha256", "evidence_sha256", "response_sha256", "model", "endpoint_shape", "temperature", "retry_count"],
      "properties": {
        "proposal_run_id": { "$ref": "#/$defs/identifier" },
        "provenance_version": { "const": "v2" },
        "prompt_sha256": { "$ref": "#/$defs/sha256" },
        "template_sha256": { "$ref": "#/$defs/sha256" },
        "evidence_sha256": { "$ref": "#/$defs/sha256" },
        "response_sha256": { "$ref": "#/$defs/sha256" },
        "model": { "type": "string", "minLength": 1 },
        "endpoint_shape": { "enum": ["openai_compatible", "official_openai", "other_disclosed"] },
        "endpoint_host": { "type": "string", "minLength": 1 },
        "temperature": { "type": "number" },
        "retry_count": { "type": "integer", "minimum": 0 },
        "evidence_frozen_at": { "type": "string", "format": "date-time", "x-volatility": "volatile" },
        "response_received_at": { "type": "string", "format": "date-time", "x-volatility": "volatile" }
      },
      "allOf": [
        {
          "if": { "required": ["provenance_version"] },
          "then": { "required": ["template_sha256", "endpoint_host", "evidence_frozen_at", "response_received_at"] }
        }
      ],
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "required": ["record_id", "phase", "actor_id", "operation_id", "status", "body_digest", "reset_fingerprint_ref", "environment_error"],
      "properties": {
        "record_id": { "$ref": "#/$defs/identifier" },
        "phase": { "enum": ["baseline", "variant"] },
        "actor_id": { "type": "string", "minLength": 1 },
        "operation_id": { "$ref": "#/$defs/operation_id" },
        "status": { "type": ["integer", "null"], "minimum": 100, "maximum": 599 },
        "body_digest": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "reset_fingerprint_ref": { "$ref": "#/$defs/artifact_record_ref" },
        "environment_error": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "target_slot": {
      "type": "object",
      "required": ["request_ref", "operation_id", "test_id", "step_id", "location", "field"],
      "properties": {
        "request_ref": {
          "allOf": [
            { "$ref": "#/$defs/artifact_record_ref" },
            { "properties": { "artifact_type": { "const": "ui_trace" } } }
          ]
        },
        "operation_id": { "$ref": "#/$defs/operation_id" },
        "test_id": { "$ref": "#/$defs/identifier" },
        "step_id": { "$ref": "#/$defs/identifier" },
        "location": { "enum": ["path", "query", "header", "body"] },
        "field": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "required": ["resolution", "selected"],
          "properties": {
            "resolution": { "const": "resolved" },
            "selected": { "$ref": "#/$defs/target_slot" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["resolution", "reason", "candidates"],
          "properties": {
            "resolution": { "const": "unresolved_zero" },
            "reason": { "type": "string", "minLength": 1 },
            "candidates": { "type": "array", "maxItems": 0, "items": { "$ref": "#/$defs/target_slot" } }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["resolution", "reason", "candidates"],
          "properties": {
            "resolution": { "const": "unresolved_multiple" },
            "reason": { "type": "string", "minLength": 1 },
            "candidates": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/target_slot" } }
          },
          "additionalProperties": false
        }
      ]
    },
    "replacement": {
      "oneOf": [
        { "type": "object", "required": ["kind", "value"], "properties": { "kind": { "const": "literal" }, "value": {} }, "additionalProperties": false },
        { "type": "object", "required": ["kind", "char", "length"], "properties": { "kind": { "const": "string_length" }, "char": { "type": "string", "minLength": 1, "maxLength": 1 }, "length": { "type": "integer", "minimum": 0 } }, "additionalProperties": false },
        { "type": "object", "required": ["kind", "boundary", "offset"], "properties": { "kind": { "const": "numeric_boundary" }, "boundary": { "enum": ["minimum", "maximum"] }, "offset": { "type": "number" } }, "additionalProperties": false },
        { "type": "object", "required": ["kind", "baseline_variant_id", "field"], "properties": { "kind": { "const": "baseline_ref" }, "baseline_variant_id": { "$ref": "#/$defs/identifier" }, "field": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
        { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "null_value" } }, "additionalProperties": false }
      ]
    },
    "admission": {
      "type": "object",
      "required": ["verdict", "reason", "baseline_observation_refs"],
      "properties": {
        "verdict": { "enum": ["ready", "rejected_malformed", "unable"] },
        "reason": { "type": ["string", "null"] },
        "baseline_observation_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "allOf": [
              { "$ref": "#/$defs/artifact_record_ref" },
              { "properties": { "artifact_type": { "const": "constraint_input_audit" } } }
            ]
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "verdict": { "const": "ready" } }, "required": ["verdict"] },
          "then": { "properties": { "reason": { "type": "null" }, "baseline_observation_refs": { "minItems": 1 } } },
          "else": { "properties": { "reason": { "type": "string", "minLength": 1 }, "baseline_observation_refs": { "maxItems": 0 } } }
        }
      ],
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": ["classification", "divergence_direction", "reason", "variant_observation_refs"],
      "properties": {
        "classification": { "enum": ["comparable_consistent", "comparable_divergent", "unable"] },
        "divergence_direction": { "type": ["string", "null"], "enum": ["backend_looser_than_ui", "backend_stricter_than_ui", null] },
        "reason": { "type": ["string", "null"] },
        "variant_observation_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "allOf": [
              { "$ref": "#/$defs/artifact_record_ref" },
              { "properties": { "artifact_type": { "const": "constraint_input_audit" } } }
            ]
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "classification": { "const": "comparable_divergent" } }, "required": ["classification"] },
          "then": { "properties": { "divergence_direction": { "enum": ["backend_looser_than_ui", "backend_stricter_than_ui"] }, "reason": { "type": "null" }, "variant_observation_refs": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "classification": { "const": "comparable_consistent" } }, "required": ["classification"] },
          "then": { "properties": { "divergence_direction": { "type": "null" }, "reason": { "type": "null" }, "variant_observation_refs": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "classification": { "const": "unable" } }, "required": ["classification"] },
          "then": { "properties": { "divergence_direction": { "type": "null" }, "reason": { "type": "string", "minLength": 1 }, "variant_observation_refs": { "maxItems": 0 } } }
        }
      ],
      "additionalProperties": false
    },
    "legacy_candidate": {
      "type": "object",
      "required": ["candidate_id", "proposal_run_id", "form_id", "field", "constraint_refs", "target", "case_kind", "replacement", "expected_ui_acceptance", "admission", "execution", "evidence_refs"],
      "properties": {
        "candidate_id": { "$ref": "#/$defs/identifier" },
        "proposal_run_id": { "$ref": "#/$defs/identifier" },
        "form_id": { "$ref": "#/$defs/identifier" },
        "field": { "type": "string", "minLength": 1 },
        "constraint_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "target": { "$ref": "#/$defs/target" },
        "case_kind": { "enum": ["valid", "boundary", "violation"] },
        "replacement": { "$ref": "#/$defs/replacement" },
        "expected_ui_acceptance": { "type": ["boolean", "null"] },
        "admission": { "$ref": "#/$defs/admission" },
        "execution": { "anyOf": [{ "$ref": "#/$defs/execution" }, { "type": "null" }] },
        "evidence_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/artifact_record_ref" } }
      },
      "allOf": [
        {
          "if": { "properties": { "admission": { "properties": { "verdict": { "const": "ready" } }, "required": ["verdict"] } }, "required": ["admission"] },
          "then": { "properties": { "execution": { "$ref": "#/$defs/execution" } } },
          "else": { "properties": { "execution": { "type": "null" } } }
        }
      ],
      "additionalProperties": false
    },
    "well_formed_candidate_v2": {
      "type": "object",
      "required": ["candidate_record_version", "candidate_shape", "candidate_id", "proposal_run_id", "form_id", "field", "constraint_refs", "target", "case_kind", "replacement", "expected_ui_acceptance", "admission", "execution", "evidence_refs"],
      "properties": {
        "candidate_record_version": { "const": "v2" },
        "candidate_shape": { "const": "well_formed" },
        "candidate_id": { "$ref": "#/$defs/identifier" },
        "proposal_run_id": { "$ref": "#/$defs/identifier" },
        "form_id": { "$ref": "#/$defs/identifier" },
        "field": { "type": "string", "minLength": 1 },
        "constraint_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "target": { "$ref": "#/$defs/target" },
        "case_kind": { "enum": ["valid", "boundary", "violation"] },
        "replacement": { "$ref": "#/$defs/replacement" },
        "expected_ui_acceptance": { "type": ["boolean", "null"] },
        "admission": { "$ref": "#/$defs/admission" },
        "execution": { "anyOf": [{ "$ref": "#/$defs/execution" }, { "type": "null" }] },
        "evidence_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/artifact_record_ref" } }
      },
      "allOf": [
        {
          "if": { "properties": { "admission": { "properties": { "verdict": { "const": "ready" } }, "required": ["verdict"] } }, "required": ["admission"] },
          "then": { "properties": { "execution": { "$ref": "#/$defs/execution" } } },
          "else": { "properties": { "execution": { "type": "null" } } }
        }
      ],
      "additionalProperties": false
    },
    "malformed_candidate_v2": {
      "type": "object",
      "required": ["candidate_record_version", "candidate_shape", "candidate_id", "proposal_run_id", "admission", "raw_proposal", "raw_proposal_sha256"],
      "properties": {
        "candidate_record_version": { "const": "v2" },
        "candidate_shape": { "const": "malformed" },
        "candidate_id": { "$ref": "#/$defs/identifier" },
        "proposal_run_id": { "$ref": "#/$defs/identifier" },
        "admission": {
          "allOf": [
            { "$ref": "#/$defs/admission" },
            {
              "properties": {
                "verdict": { "const": "rejected_malformed" },
                "reason": { "type": "string", "minLength": 1 },
                "baseline_observation_refs": { "maxItems": 0 }
              }
            }
          ]
        },
        "raw_proposal": { "type": "object" },
        "raw_proposal_sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "candidate": {
      "oneOf": [
        { "$ref": "#/$defs/legacy_candidate" },
        { "$ref": "#/$defs/well_formed_candidate_v2" },
        { "$ref": "#/$defs/malformed_candidate_v2" }
      ]
    }
  }
}
