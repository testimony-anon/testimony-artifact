    "projection_plan_materialized": {"type": "object", "additionalProperties": false, "required": ["artifact_ref", "artifact_sha256", "predicate_family", "body_path", "derived_from_field", "canonicalization", "materialized_before_observation", "result_adaptive_selection"], "properties": {
