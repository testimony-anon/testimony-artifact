    "attempted_failed": {"type": "object", "additionalProperties": false, "required": ["slot", "state", "raw_ref", "raw_sha256", "started_at", "finished_at", "status", "arm", "error_ref", "error_sha256", "reason_code"], "properties": {"slot": {"type": "string"}, "state": {"const": "executed"}, "raw_ref": {"type": "string", "minLength": 1}, "raw_sha256": {"$ref": "#/$defs/sha"}, "started_at": {"$ref": "#/$defs/ts"}, "finished_at": {"$ref": "#/$defs/ts"}, "status": {"const": "failed"}, "arm": {"enum": ["control", "treatment"]}, "error_ref": {"type": "string", "minLength": 1}, "error_sha256": {"$ref": "#/$defs/sha"}, "reason_code": {"type": "string", "minLength": 1}}},
