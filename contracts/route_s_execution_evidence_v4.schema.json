      "schema_version": {"const": "uisemtest-oracle-candidate-v1"}, "candidate_id": {"type": "string", "minLength": 1}, "candidate_identity": {"type": "string", "minLength": 1}, "normalized_candidate_sha256": {"$ref": "#/$defs/sha"}, "source_hashes": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/sha"}},
      "producer": {"$ref": "#/$defs/endpoint"}, "consumer": {"$ref": "#/$defs/endpoint"}, "setup": {"type": "array", "items": {"$ref": "#/$defs/endpoint"}}, "contract_kind": {"enum": ["C01", "C02", "C03", "C11"]}, "observation_opportunity_ref": {"type": "string", "minLength": 1}, "primary_predicate": {"type": "object"}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "predicate_family": {"enum": ["P01", "P02", "P04", "P06", "P12", "P14", "unsupported"]}
