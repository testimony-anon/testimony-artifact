{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assertion_audit.schema.json",
  "title": "assertion_audit — assertion proposal, lint and promotion audit (Stage 5)",
  "description": "Holds all candidates from the four assertion sources. The official test_suite references only items that passed lint; run-time calibration results go into test_execution_report and are not written back to this artifact.",
  "type": "object",
  "required": ["metadata", "proposal_runs", "candidates"],
  "properties": {
    "metadata": {
      "$ref": "metadata_envelope.schema.json",
      "properties": {
        "artifact_type": { "const": "assertion_audit" },
        "stage": { "const": "stage5" }
      }
    },
    "proposal_runs": {
      "type": "array",
      "items": { "$ref": "#/$defs/proposal_run" },
      "x-volatility": "volatile"
    },
    "transform_evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/unit_scale_evidence" },
      "x-volatility": "structural"
    },
    "candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidate" },
      "x-volatility": "structural"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "observation_ref": {
      "type": "object",
      "required": ["artifact_type", "run_id", "record_id", "value_path"],
      "properties": {
        "artifact_type": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "record_id": { "type": "string", "minLength": 1 },
        "value_path": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "unit_scale_pair": {
      "type": "object",
      "required": ["ui_observation_ref", "api_observation_ref", "ui_text_sha256", "parsed_ui_value", "api_value", "ratio"],
      "properties": {
        "ui_observation_ref": { "$ref": "#/$defs/observation_ref" },
        "api_observation_ref": { "$ref": "#/$defs/observation_ref" },
        "ui_text_sha256": { "$ref": "#/$defs/sha256" },
        "parsed_ui_value": { "type": "number" },
        "api_value": { "type": "number" },
        "ratio": { "type": "number" }
      },
      "additionalProperties": false
    },
    "unit_scale_evidence": {
      "type": "object",
      "required": ["evidence_id", "quantity_key", "derivation_status", "factor", "pairs", "parser", "absolute_tolerance", "relative_tolerance", "derived_at"],
      "properties": {
        "evidence_id": { "type": "string", "minLength": 1 },
        "quantity_key": { "type": "string", "minLength": 1 },
        "derivation_status": { "enum": ["confirmed", "review_required", "rejected"] },
        "factor": { "type": ["integer", "null"], "minimum": 1 },
        "pairs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/unit_scale_pair" } },
        "parser": { "const": "currency_decimal_v1" },
        "absolute_tolerance": { "const": 1e-9 },
        "relative_tolerance": { "const": 1e-9 },
        "derived_at": { "type": "string", "format": "date-time", "x-volatility": "volatile" }
      },
      "additionalProperties": false
    },
    "assertion_source": {
      "type": "string",
      "enum": ["value_flow", "ui_diff", "ui_constraint", "ui_assertion_transfer"]
    },
    "proposal_run": {
      "type": "object",
      "required": ["proposal_run_id", "prompt_sha256", "evidence_sha256", "response_sha256", "model", "endpoint_shape", "temperature", "retry_count"],
      "properties": {
        "proposal_run_id": { "type": "string", "minLength": 1 },
        "provenance_version": { "const": "v2" },
        "prompt_sha256": { "$ref": "#/$defs/sha256" },
        "template_sha256": { "$ref": "#/$defs/sha256" },
        "evidence_sha256": { "$ref": "#/$defs/sha256" },
        "response_sha256": { "$ref": "#/$defs/sha256" },
        "model": { "type": "string", "minLength": 1 },
        "endpoint_shape": { "type": "string", "enum": ["openai_compatible", "official_openai", "other_disclosed"] },
        "endpoint_host": { "type": "string", "minLength": 1 },
        "temperature": { "type": "number" },
        "retry_count": { "type": "integer", "minimum": 0 },
        "evidence_frozen_at": { "type": "string", "format": "date-time", "x-volatility": "volatile" },
        "response_received_at": { "type": "string", "format": "date-time", "x-volatility": "volatile" }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": ["provenance_version"],
            "properties": { "provenance_version": { "const": "v2" } }
          },
          "then": {
            "required": ["template_sha256", "endpoint_host", "evidence_frozen_at", "response_received_at"]
          }
        }
      ]
    },
    "artifact_record_ref": {
      "type": "object",
      "required": ["artifact_type", "run_id", "record_id"],
      "properties": {
        "artifact_type": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "record_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": ["candidate_id", "assertion_source", "raw_predicate", "lint_verdict", "evidence_refs"],
      "properties": {
        "candidate_id": { "type": "string", "minLength": 1 },
        "assertion_source": { "$ref": "#/$defs/assertion_source" },
        "proposal_run_id": { "type": ["string", "null"], "minLength": 1 },
        "raw_predicate": { "type": "object" },
        "lint_verdict": { "type": "string", "enum": ["pass", "rejected_malformed", "rejected_out_of_scope"] },
        "lint_reason": { "type": ["string", "null"] },
        "promoted_test_ref": { "type": ["string", "null"] },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifact_record_ref" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "assertion_source": { "const": "value_flow" } }, "required": ["assertion_source"] },
          "then": { "properties": { "proposal_run_id": { "type": "null" } } },
          "else": { "required": ["proposal_run_id"], "properties": { "proposal_run_id": { "type": "string", "minLength": 1 } } }
        },
        {
          "if": { "properties": { "lint_verdict": { "const": "pass" } }, "required": ["lint_verdict"] },
          "then": { "properties": { "lint_reason": { "type": "null" } } },
          "else": { "required": ["lint_reason"], "properties": { "promoted_test_ref": { "type": "null" } } }
        }
      ],
      "additionalProperties": false
    }
  }
}
