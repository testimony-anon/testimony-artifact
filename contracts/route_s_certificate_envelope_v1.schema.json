{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "route_s_certificate_envelope_v1.schema.json",
  "type": "object",
  "required": ["schema_version", "status", "execution_evidence_sha256", "execution_binding", "route_s_certificate", "qualifying_seal_required", "live_result_eligible"],
  "properties": {
    "schema_version": {"const": "ui-semantics-route-s-certificate-envelope-v1"},
    "status": {"const": "rendered_awaiting_post_render_scan_and_final_seal"},
    "execution_evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution_binding": {"$ref": "route_s_execution_binding_v1.schema.json"},
    "route_s_certificate": {"$ref": "route_s_certificate_v4.schema.json"},
    "qualifying_seal_required": {"const": true},
    "live_result_eligible": {"const": false}
  },
  "additionalProperties": false
}
