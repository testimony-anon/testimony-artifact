{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "route_s_certificate_v4.schema.json",
  "title": "Route-S final deterministic certificate v4",
  "type": "object",
  "required": ["schema_version", "certificate_status", "execution_evidence_sha256", "candidate", "projection_plan", "protocol", "observation_projections", "gates", "sessions", "cross_arm_reuse_refs", "pins", "run_attestation", "outcome", "outcome_precedence_version", "fail_closed_reasons", "completeness"],
  "properties": {
    "schema_version": {"const": "ui-semantics-route-s-certificate-v4"}, "certificate_status": {"const": "final"}, "execution_evidence_sha256": {"$ref": "#/$defs/sha"},
    "candidate": {"$ref": "route_s_execution_evidence_v4.schema.json#/$defs/candidate"}, "projection_plan": {"$ref": "route_s_execution_evidence_v4.schema.json#/$defs/projection_plan"},
    "protocol": {"type": "object", "additionalProperties": false, "required": ["Rc", "Sc", "Oc1", "settle_c", "Oc2", "Rt", "St", "Ot0", "P", "settle_t", "Ot1"], "properties": {
      "Rc": {"$ref": "#/$defs/Rc"}, "Sc": {"$ref": "#/$defs/Sc"}, "Oc1": {"$ref": "#/$defs/Oc1"}, "settle_c": {"$ref": "#/$defs/settle_c"}, "Oc2": {"$ref": "#/$defs/Oc2"}, "Rt": {"$ref": "#/$defs/Rt"}, "St": {"$ref": "#/$defs/St"}, "Ot0": {"$ref": "#/$defs/Ot0"}, "P": {"$ref": "#/$defs/P"}, "settle_t": {"$ref": "#/$defs/settle_t"}, "Ot1": {"$ref": "#/$defs/Ot1"}
    }},
    "observation_projections": {"type": "object", "additionalProperties": false, "required": ["Oc1", "Oc2", "Ot0", "Ot1"], "properties": {"Oc1": {"$ref": "#/$defs/projection_or_absent"}, "Oc2": {"$ref": "#/$defs/projection_or_absent"}, "Ot0": {"$ref": "#/$defs/projection_or_absent"}, "Ot1": {"$ref": "#/$defs/projection_or_absent"}}},
    "gates": {"type": "object", "additionalProperties": false, "required": ["observer_pure", "stable_control", "baseline_equivalent", "supplemental_baseline", "control_effect_absent", "treatment_effect_present", "isolated"], "properties": {"observer_pure": {"$ref": "#/$defs/gate"}, "stable_control": {"$ref": "#/$defs/gate"}, "baseline_equivalent": {"$ref": "#/$defs/gate"}, "supplemental_baseline": {"$ref": "#/$defs/gate"}, "control_effect_absent": {"$ref": "#/$defs/gate"}, "treatment_effect_present": {"$ref": "#/$defs/gate"}, "isolated": {"$ref": "#/$defs/gate"}}},
    "sessions": {"type": "array", "items": {"$ref": "route_s_execution_evidence_v4.schema.json#/$defs/session"}}, "cross_arm_reuse_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "pins": {"$ref": "route_s_execution_evidence_v4.schema.json#/$defs/pins"}, "run_attestation": {"$ref": "route_s_execution_evidence_v4.schema.json#/$defs/attestation"},
    "outcome": {"enum": ["confirmed", "effect_absent", "baseline_mismatch", "control_unstable", "observer_mutating_or_uncertain", "arm_isolation_failed", "setup_failed", "infrastructure_failed", "malformed_or_unsupported"]},
    "outcome_precedence_version": {"const": "route-s-outcome-precedence-v5"}, "fail_closed_reasons": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "completeness": {"type": "object", "additionalProperties": false, "required": ["required_fields_complete", "schema_validated", "artifact_hashes_verified", "secret_values_present"], "properties": {"required_fields_complete": {"const": true}, "schema_validated": {"const": true}, "artifact_hashes_verified": {"const": true}, "secret_values_present": {"const": false}}}
  },
  "additionalProperties": false,
  "allOf": [{"if": {"properties": {"outcome": {"const": "confirmed"}}, "required": ["outcome"]}, "then": {"properties": {
    "fail_closed_reasons": {"maxItems": 0}, "sessions": {"minItems": 2}, "cross_arm_reuse_refs": {"maxItems": 0},
    "candidate": {"properties": {"predicate_family": {"enum": ["P01", "P02", "P04", "P06", "P12", "P14"]}}},
    "projection_plan": {"$ref": "route_s_execution_evidence_v4.schema.json#/$defs/projection_plan_materialized"},
    "protocol": {"properties": {"Rc": {"$ref": "#/$defs/executed_pass"}, "Sc": {"$ref": "#/$defs/executed_pass"}, "Oc1": {"$ref": "#/$defs/executed_pass"}, "settle_c": {"$ref": "#/$defs/executed_pass"}, "Oc2": {"$ref": "#/$defs/executed_pass"}, "Rt": {"$ref": "#/$defs/executed_pass"}, "St": {"$ref": "#/$defs/executed_pass"}, "Ot0": {"$ref": "#/$defs/executed_pass"}, "P": {"$ref": "#/$defs/executed_pass"}, "settle_t": {"$ref": "#/$defs/executed_pass"}, "Ot1": {"$ref": "#/$defs/executed_pass"}}},
    "observation_projections": {"properties": {"Oc1": {"$ref": "#/$defs/projection"}, "Oc2": {"$ref": "#/$defs/projection"}, "Ot0": {"$ref": "#/$defs/projection"}, "Ot1": {"$ref": "#/$defs/projection"}}},
    "gates": {"properties": {"observer_pure": {"$ref": "#/$defs/gate_true"}, "stable_control": {"$ref": "#/$defs/gate_true"}, "baseline_equivalent": {"$ref": "#/$defs/gate_true"}, "control_effect_absent": {"$ref": "#/$defs/gate_true"}, "treatment_effect_present": {"$ref": "#/$defs/gate_true"}, "isolated": {"$ref": "#/$defs/gate_true"}}}
  }}}],
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "ts": {"type": "string", "format": "date-time"},
    "not_executed": {"type": "object", "additionalProperties": false, "required": ["slot", "state", "reason_code"], "properties": {"slot": {"type": "string"}, "state": {"const": "not_executed"}, "reason_code": {"type": "string", "minLength": 1}}},
    "executed": {"type": "object", "required": ["slot", "state", "raw_ref", "raw_sha256", "started_at", "finished_at", "status", "arm"], "properties": {"slot": {"type": "string"}, "state": {"const": "executed"}, "raw_ref": {"type": "string", "minLength": 1}, "raw_sha256": {"$ref": "#/$defs/sha"}, "started_at": {"$ref": "#/$defs/ts"}, "finished_at": {"$ref": "#/$defs/ts"}, "status": {"const": "pass"}, "arm": {"enum": ["control", "treatment"]}}},
    "attempted_failed": {"type": "object", "additionalProperties": false, "required": ["slot", "state", "raw_ref", "raw_sha256", "started_at", "finished_at", "status", "arm", "error_ref", "error_sha256", "reason_code"], "properties": {"slot": {"type": "string"}, "state": {"const": "executed"}, "raw_ref": {"type": "string", "minLength": 1}, "raw_sha256": {"$ref": "#/$defs/sha"}, "started_at": {"$ref": "#/$defs/ts"}, "finished_at": {"$ref": "#/$defs/ts"}, "status": {"const": "failed"}, "arm": {"enum": ["control", "treatment"]}, "error_ref": {"type": "string", "minLength": 1}, "error_sha256": {"$ref": "#/$defs/sha"}, "reason_code": {"type": "string", "minLength": 1}}},
    "settle_attempted_failed": {"type": "object", "additionalProperties": false, "required": ["slot", "state", "raw_ref", "raw_sha256", "started_at", "finished_at", "status", "arm", "error_ref", "error_sha256", "reason_code", "policy_ref", "policy_sha256", "policy", "elapsed_ns", "poll_count", "consecutive_identical", "projection_sha256"], "properties": {"slot": {"type": "string"}, "state": {"const": "executed"}, "raw_ref": {"type": "string", "minLength": 1}, "raw_sha256": {"$ref": "#/$defs/sha"}, "started_at": {"$ref": "#/$defs/ts"}, "finished_at": {"$ref": "#/$defs/ts"}, "status": {"const": "failed"}, "arm": {"enum": ["control", "treatment"]}, "error_ref": {"type": "string", "minLength": 1}, "error_sha256": {"$ref": "#/$defs/sha"}, "reason_code": {"type": "string", "minLength": 1}, "policy_ref": {"type": "string", "minLength": 1}, "policy_sha256": {"$ref": "#/$defs/sha"}, "policy": {"type": "object"}, "elapsed_ns": {"type": "integer", "minimum": 0}, "poll_count": {"type": "integer", "minimum": 0}, "consecutive_identical": {"type": "integer", "minimum": 0}, "projection_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}}},
    "reset_pass": {"allOf": [{"$ref": "#/$defs/executed"}, {"type": "object", "required": ["reset_epoch"], "properties": {"reset_epoch": {"type": "string", "minLength": 1}}}]},
    "setup_pass": {"allOf": [{"$ref": "#/$defs/executed"}, {"type": "object", "required": ["provenance_refs"], "properties": {"provenance_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}}}]},
    "observation_pass": {"allOf": [{"$ref": "#/$defs/executed"}, {"type": "object", "required": ["actor_id", "request_sha256", "response_sha256"], "properties": {"actor_id": {"type": "string", "minLength": 1}, "request_sha256": {"$ref": "#/$defs/sha"}, "response_sha256": {"$ref": "#/$defs/sha"}}}]},
    "producer_pass": {"allOf": [{"$ref": "#/$defs/executed"}, {"type": "object", "required": ["actor_id", "action_ref", "request_ref", "request_sha256", "response_sha256"], "properties": {"actor_id": {"type": "string", "minLength": 1}, "action_ref": {"type": "string", "minLength": 1}, "request_ref": {"type": "string", "minLength": 1}, "request_sha256": {"$ref": "#/$defs/sha"}, "response_sha256": {"$ref": "#/$defs/sha"}}}]},
    "settle_pass": {"allOf": [{"$ref": "#/$defs/executed"}, {"type": "object", "required": ["policy_ref", "policy_sha256"], "properties": {"policy_ref": {"type": "string", "minLength": 1}, "policy_sha256": {"$ref": "#/$defs/sha"}}}]},
    "executed_pass": {"properties": {"state": {"const": "executed"}, "status": {"const": "pass"}}, "required": ["state", "status"]},
    "slot": {"oneOf": [{"$ref": "#/$defs/executed"}, {"$ref": "#/$defs/attempted_failed"}, {"$ref": "#/$defs/not_executed"}]},
    "Rc": {"oneOf": [{"allOf": [{"$ref": "#/$defs/reset_pass"}, {"properties": {"slot": {"const": "Rc"}, "arm": {"const": "control"}}}]}, {"allOf": [{"$ref": "#/$defs/attempted_failed"}, {"properties": {"slot": {"const": "Rc"}, "arm": {"const": "control"}}}]}, {"allOf": [{"$ref": "#/$defs/not_executed"}, {"properties": {"slot": {"const": "Rc"}}}]}]},
    "Sc": {"oneOf": [{"allOf": [{"$ref": "#/$defs/setup_pass"}, {"properties": {"slot": {"const": "Sc"}, "arm": {"const": "control"}}}]}, {"allOf": [{"$ref": "#/$defs/attempted_failed"}, {"properties": {"slot": {"const": "Sc"}, "arm": {"const": "control"}}}]}, {"allOf": [{"$ref": "#/$defs/not_executed"}, {"properties": {"slot": {"const": "Sc"}}}]}]},
    "Oc1": {"oneOf": [{"allOf": [{"$ref": "#/$defs/observation_pass"}, {"properties": {"slot": {"const": "Oc1"}, "arm": {"const": "control"}}}]}, {"allOf": [{"$ref": "#/$defs/attempted_failed"}, {"properties": {"slot": {"const": "Oc1"}, "arm": {"const": "control"}}}]}, {"allOf": [{"$ref": "#/$defs/not_executed"}, {"properties": {"slot": {"const": "Oc1"}}}]}]},
    "settle_c": {"oneOf": [{"allOf": [{"$ref": "#/$defs/settle_pass"}, {"properties": {"slot": {"const": "settle_c"}, "arm": {"const": "control"}}}]}, {"allOf": [{"$ref": "#/$defs/settle_attempted_failed"}, {"properties": {"slot": {"const": "settle_c"}, "arm": {"const": "control"}}}]}, {"allOf": [{"$ref": "#/$defs/not_executed"}, {"properties": {"slot": {"const": "settle_c"}}}]}]},
    "Oc2": {"oneOf": [{"allOf": [{"$ref": "#/$defs/observation_pass"}, {"properties": {"slot": {"const": "Oc2"}, "arm": {"const": "control"}}}]}, {"allOf": [{"$ref": "#/$defs/attempted_failed"}, {"properties": {"slot": {"const": "Oc2"}, "arm": {"const": "control"}}}]}, {"allOf": [{"$ref": "#/$defs/not_executed"}, {"properties": {"slot": {"const": "Oc2"}}}]}]},
    "Rt": {"oneOf": [{"allOf": [{"$ref": "#/$defs/reset_pass"}, {"properties": {"slot": {"const": "Rt"}, "arm": {"const": "treatment"}}}]}, {"allOf": [{"$ref": "#/$defs/attempted_failed"}, {"properties": {"slot": {"const": "Rt"}, "arm": {"const": "treatment"}}}]}, {"allOf": [{"$ref": "#/$defs/not_executed"}, {"properties": {"slot": {"const": "Rt"}}}]}]},
    "St": {"oneOf": [{"allOf": [{"$ref": "#/$defs/setup_pass"}, {"properties": {"slot": {"const": "St"}, "arm": {"const": "treatment"}}}]}, {"allOf": [{"$ref": "#/$defs/attempted_failed"}, {"properties": {"slot": {"const": "St"}, "arm": {"const": "treatment"}}}]}, {"allOf": [{"$ref": "#/$defs/not_executed"}, {"properties": {"slot": {"const": "St"}}}]}]},
    "Ot0": {"oneOf": [{"allOf": [{"$ref": "#/$defs/observation_pass"}, {"properties": {"slot": {"const": "Ot0"}, "arm": {"const": "treatment"}}}]}, {"allOf": [{"$ref": "#/$defs/attempted_failed"}, {"properties": {"slot": {"const": "Ot0"}, "arm": {"const": "treatment"}}}]}, {"allOf": [{"$ref": "#/$defs/not_executed"}, {"properties": {"slot": {"const": "Ot0"}}}]}]},
    "P": {"oneOf": [{"allOf": [{"$ref": "#/$defs/producer_pass"}, {"properties": {"slot": {"const": "P"}, "arm": {"const": "treatment"}}}]}, {"allOf": [{"$ref": "#/$defs/attempted_failed"}, {"properties": {"slot": {"const": "P"}, "arm": {"const": "treatment"}}}]}, {"allOf": [{"$ref": "#/$defs/not_executed"}, {"properties": {"slot": {"const": "P"}}}]}]},
    "settle_t": {"oneOf": [{"allOf": [{"$ref": "#/$defs/settle_pass"}, {"properties": {"slot": {"const": "settle_t"}, "arm": {"const": "treatment"}}}]}, {"allOf": [{"$ref": "#/$defs/settle_attempted_failed"}, {"properties": {"slot": {"const": "settle_t"}, "arm": {"const": "treatment"}}}]}, {"allOf": [{"$ref": "#/$defs/not_executed"}, {"properties": {"slot": {"const": "settle_t"}}}]}]},
    "Ot1": {"oneOf": [{"allOf": [{"$ref": "#/$defs/observation_pass"}, {"properties": {"slot": {"const": "Ot1"}, "arm": {"const": "treatment"}}}]}, {"allOf": [{"$ref": "#/$defs/attempted_failed"}, {"properties": {"slot": {"const": "Ot1"}, "arm": {"const": "treatment"}}}]}, {"allOf": [{"$ref": "#/$defs/not_executed"}, {"properties": {"slot": {"const": "Ot1"}}}]}]},
    "observer_result": {"type": "object", "additionalProperties": false, "required": ["domain", "disposition", "value", "reason_code", "before_sha256", "after_sha256", "capability_ref", "capability_sha256"], "properties": {"domain": {"enum": ["cookie", "token", "cache", "last_seen"]}, "disposition": {"enum": ["proven_unchanged", "mutating", "uncertain", "not_applicable"]}, "value": {"type": "boolean"}, "reason_code": {"type": "string"}, "before_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "after_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "capability_ref": {"type": "string"}, "capability_sha256": {"$ref": "#/$defs/sha"}}},
    "projection": {"type": "object", "additionalProperties": false, "required": ["raw_ref", "raw_sha256", "observed_at", "normalized_projection", "projection_sha256", "observer_domain_results"], "properties": {"raw_ref": {"type": "string"}, "raw_sha256": {"$ref": "#/$defs/sha"}, "observed_at": {"$ref": "#/$defs/ts"}, "normalized_projection": {}, "projection_sha256": {"$ref": "#/$defs/sha"}, "observer_domain_results": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/observer_result"}}}},
    "projection_absent": {"type": "object", "additionalProperties": false, "required": ["state", "reason_code"], "properties": {"state": {"const": "not_projected"}, "reason_code": {"type": "string", "minLength": 1}}}, "projection_or_absent": {"oneOf": [{"$ref": "#/$defs/projection"}, {"$ref": "#/$defs/projection_absent"}]},
    "operand": {"type": "object", "additionalProperties": false, "required": ["name", "raw_ref", "operator", "normalization_rule", "normalized_value", "normalized_value_sha256"], "properties": {"name": {"type": "string"}, "raw_ref": {"type": "string"}, "operator": {"type": "string"}, "normalization_rule": {"type": "string"}, "normalized_value": {}, "normalized_value_sha256": {"$ref": "#/$defs/sha"}}},
    "gate": {"type": "object", "additionalProperties": false, "required": ["computed", "value", "reason_code", "evaluator_sha256", "operands"], "properties": {"computed": {"type": "boolean"}, "value": {"type": ["boolean", "null"]}, "reason_code": {"type": "string"}, "evaluator_sha256": {"$ref": "#/$defs/sha"}, "operands": {"type": "array", "items": {"$ref": "#/$defs/operand"}}}},
    "gate_true": {"properties": {"computed": {"const": true}, "value": {"const": true}}, "required": ["computed", "value"]}
  }
}
