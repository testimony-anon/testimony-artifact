{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "route_s_certificate_envelope_v3.schema.json",
  "type": "object",
  "required": ["schema_version", "status", "execution_evidence_sha256", "pre_live_binding_pins", "v1_envelope", "qualifying_seal_required", "live_result_eligible"],
  "properties": {
    "schema_version": {"const": "ui-semantics-route-s-certificate-envelope-v3"},
    "status": {"const": "rendered_awaiting_post_render_scan_and_final_seal"},
    "execution_evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pre_live_binding_pins": {"$ref": "route_s_pre_live_binding_pins_v2.schema.json"},
    "v1_envelope": {"$ref": "route_s_certificate_envelope_v1.schema.json"},
    "qualifying_seal_required": {"const": true},
    "live_result_eligible": {"const": false}
  },
  "additionalProperties": false
}
