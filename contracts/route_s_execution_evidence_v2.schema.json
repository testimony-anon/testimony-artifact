{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "route_s_execution_evidence_v2.schema.json",
  "title": "Route-S generic execution evidence v2",
  "type": "object",
  "required": ["schema_version", "candidate", "projection_plan", "protocol", "sessions", "cross_arm_reuse_refs", "pins", "run_attestation"],
  "properties": {
    "schema_version": {"const": "ui-semantics-route-s-execution-evidence-v2"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "projection_plan": {"$ref": "#/$defs/projection_plan"},
    "protocol": {
      "type": "object",
      "required": ["Rc", "Sc", "Oc1", "settle_c", "Oc2", "Rt", "St", "Ot0", "P", "settle_t", "Ot1"],
      "properties": {
        "Rc": {"$ref": "#/$defs/slot"}, "Sc": {"$ref": "#/$defs/slot"},
        "Oc1": {"$ref": "#/$defs/slot"}, "settle_c": {"$ref": "#/$defs/slot"},
        "Oc2": {"$ref": "#/$defs/slot"}, "Rt": {"$ref": "#/$defs/slot"},
        "St": {"$ref": "#/$defs/slot"}, "Ot0": {"$ref": "#/$defs/slot"},
        "P": {"$ref": "#/$defs/slot"}, "settle_t": {"$ref": "#/$defs/slot"},
        "Ot1": {"$ref": "#/$defs/slot"}
      },
      "additionalProperties": false
    },
    "sessions": {"type": "array", "items": {"$ref": "#/$defs/session"}},
    "cross_arm_reuse_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "pins": {"$ref": "#/$defs/pins"},
    "run_attestation": {"$ref": "#/$defs/run_attestation"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "endpoint": {
      "type": "object", "required": ["actor_id", "request_ref"],
      "properties": {"actor_id": {"type": "string", "minLength": 1}, "request_ref": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": ["candidate_id", "candidate_identity", "normalized_candidate_sha256", "source_hashes", "producer", "consumer", "setup", "effect_predicate", "transform_evidence"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "candidate_identity": {"type": "string", "minLength": 1},
        "normalized_candidate_sha256": {"$ref": "#/$defs/sha256"},
        "source_hashes": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/sha256"}},
        "producer": {"$ref": "#/$defs/endpoint"},
        "consumer": {"$ref": "#/$defs/endpoint"},
        "setup": {"type": "array", "items": {"$ref": "#/$defs/endpoint"}},
        "effect_predicate": {"type": "object", "required": ["type"], "additionalProperties": true},
        "transform_evidence": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": false
    },
    "projection_plan": {
      "type": "object",
      "required": ["artifact_ref", "artifact_sha256", "predicate_type", "body_path", "derived_from_field", "canonicalization", "materialized_before_observation", "result_adaptive_selection"],
      "properties": {
        "artifact_ref": {"type": "string", "minLength": 1},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "predicate_type": {"enum": ["numeric_delta", "count_delta", "item_appears", "field_equals"]},
        "body_path": {"type": "string"},
        "derived_from_field": {"enum": ["target_path", "collection_path"]},
        "canonicalization": {"const": "typed_canonical_json_object_keys_array_order_preserved_no_coercion"},
        "materialized_before_observation": {"const": true},
        "result_adaptive_selection": {"const": false}
      },
      "additionalProperties": false
    },
    "observer_domain": {
      "type": "object",
      "required": ["domain", "disposition", "before_sha256", "after_sha256", "mutation_events", "uncertain_fields", "capability_ref", "capability_sha256", "reason_code"],
      "properties": {
        "domain": {"enum": ["cookie", "token", "cache", "last_seen"]},
        "disposition": {"enum": ["proven_unchanged", "mutating", "uncertain", "not_applicable"]},
        "before_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "after_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "mutation_events": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "uncertain_fields": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "capability_ref": {"type": "string", "minLength": 1},
        "capability_sha256": {"$ref": "#/$defs/sha256"},
        "reason_code": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "executed_slot": {
      "type": "object",
      "required": ["slot", "state", "raw_ref", "raw_sha256", "started_at", "finished_at", "status"],
      "properties": {
        "slot": {"enum": ["Rc", "Sc", "Oc1", "settle_c", "Oc2", "Rt", "St", "Ot0", "P", "settle_t", "Ot1"]},
        "state": {"const": "executed"},
        "raw_ref": {"type": "string", "minLength": 1},
        "raw_sha256": {"$ref": "#/$defs/sha256"},
        "started_at": {"$ref": "#/$defs/timestamp"},
        "finished_at": {"$ref": "#/$defs/timestamp"},
        "status": {"enum": ["pass", "failed"]},
        "arm": {"enum": ["control", "treatment"]},
        "actor_id": {"type": "string", "minLength": 1},
        "reset_epoch": {"type": "string", "minLength": 1},
        "provenance_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "request": {}, "response": {},
        "action_ref": {"type": "string", "minLength": 1},
        "request_ref": {"type": "string", "minLength": 1},
        "observer_domains": {"type": "array", "items": {"$ref": "#/$defs/observer_domain"}}
      },
      "additionalProperties": false
    },
    "not_executed_slot": {
      "type": "object",
      "required": ["slot", "state", "reason_code"],
      "properties": {
        "slot": {"enum": ["Rc", "Sc", "Oc1", "settle_c", "Oc2", "Rt", "St", "Ot0", "P", "settle_t", "Ot1"]},
        "state": {"const": "not_executed"},
        "reason_code": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "slot": {"oneOf": [{"$ref": "#/$defs/executed_slot"}, {"$ref": "#/$defs/not_executed_slot"}]},
    "session": {
      "type": "object",
      "required": ["arm", "actor_id", "reset_epoch", "materialization_id", "ownership_domain_sha256", "jar_ownership_sha256", "mutation_domain_sha256", "secret_values_present"],
      "properties": {
        "arm": {"enum": ["control", "treatment"]}, "actor_id": {"type": "string", "minLength": 1},
        "reset_epoch": {"type": "string", "minLength": 1}, "materialization_id": {"type": "string", "minLength": 1},
        "ownership_domain_sha256": {"$ref": "#/$defs/sha256"}, "jar_ownership_sha256": {"$ref": "#/$defs/sha256"},
        "mutation_domain_sha256": {"$ref": "#/$defs/sha256"}, "secret_values_present": {"const": false}
      },
      "additionalProperties": false
    },
    "pins": {
      "type": "object",
      "required": ["verifier_sha256", "certificate_schema_sha256", "execution_evidence_schema_sha256", "projector_sha256", "equivalence_sha256", "predicate_evaluator_sha256", "predicate_linter_sha256", "observer_request_policy_sha256", "reset_driver_sha256", "session_materializer_sha256", "settle_policy_sha256", "profile_sha256", "renderer_sha256", "subject_pin_sha256"],
      "properties": {
        "verifier_sha256": {"$ref": "#/$defs/sha256"}, "certificate_schema_sha256": {"$ref": "#/$defs/sha256"},
        "execution_evidence_schema_sha256": {"$ref": "#/$defs/sha256"}, "projector_sha256": {"$ref": "#/$defs/sha256"},
        "equivalence_sha256": {"$ref": "#/$defs/sha256"}, "predicate_evaluator_sha256": {"$ref": "#/$defs/sha256"},
        "predicate_linter_sha256": {"$ref": "#/$defs/sha256"}, "observer_request_policy_sha256": {"$ref": "#/$defs/sha256"},
        "reset_driver_sha256": {"$ref": "#/$defs/sha256"}, "session_materializer_sha256": {"$ref": "#/$defs/sha256"},
        "settle_policy_sha256": {"$ref": "#/$defs/sha256"}, "profile_sha256": {"$ref": "#/$defs/sha256"},
        "renderer_sha256": {"$ref": "#/$defs/sha256"}, "subject_pin_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "run_attestation": {
      "type": "object",
      "required": ["secret_scan_ref", "secret_scan_sha256", "secret_scan_status", "secret_findings", "scan_scope", "provider_calls", "no_feedback"],
      "properties": {
        "secret_scan_ref": {"type": "string", "minLength": 1}, "secret_scan_sha256": {"$ref": "#/$defs/sha256"},
        "secret_scan_status": {"const": "pass"}, "secret_findings": {"const": 0}, "scan_scope": {"const": "all_route_s_run_artifacts"}, "provider_calls": {"const": 0}, "no_feedback": {"const": true}
      },
      "additionalProperties": false
    }
  }
}
