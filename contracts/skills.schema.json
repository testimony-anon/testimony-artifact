{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skills.schema.json",
  "title": "skills — skeleton skills (produced by Stage 5; decision record 000 §2.7)",
  "description": "A V1 skill is a skeleton: = sequence + data bindings + parameterized entry points, without intent labels or natural-language descriptions (intent_label/description are optional fields reserved for the language-model proposer and are not filled in V1). All are in candidate state when produced. Skills are volatile assets (must be re-validated by Stage 6 before use).",
  "type": "object",
  "required": ["metadata", "skills"],
  "properties": {
    "metadata": {
      "$ref": "metadata_envelope.schema.json",
      "properties": {
        "artifact_type": { "const": "skills" },
        "stage": { "const": "stage5" }
      }
    },
    "skills": {
      "type": "array",
      "items": { "$ref": "#/$defs/skill" },
      "x-volatility": "volatile"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "parameter": {
      "type": "object",
      "description": "Parameterized entry point: an external input supplied by the skill caller and its binding target",
      "required": ["name", "to_step", "to_location", "to_field"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "to_step": {
          "type": "integer",
          "minimum": 0
        },
        "to_location": {
          "type": "string",
          "enum": ["path", "query", "header", "body"]
        },
        "to_field": {
          "type": "string",
          "description": "Target location: the parameter name for path/query/header; a JSON Pointer for body"
        },
        "required": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false,
      "x-volatility": "structural"
    },
    "skill": {
      "type": "object",
      "required": ["skill_id", "steps", "bindings", "parameters", "status"],
      "properties": {
        "skill_id": {
          "type": "string",
          "minLength": 1,
          "x-volatility": "volatile"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "description": "Ordered list of operationIds (same shape as test_sequences)",
          "items": { "$ref": "test_sequences.schema.json#/$defs/operation_id" },
          "x-volatility": "structural"
        },
        "bindings": {
          "type": "array",
          "description": "Data bindings between steps (same shape as test_sequences, including the optional from_location; default/absent is equivalent to response_body)",
          "items": { "$ref": "test_sequences.schema.json#/$defs/binding" },
          "x-volatility": "structural"
        },
        "parameters": {
          "type": "array",
          "items": { "$ref": "#/$defs/parameter" },
          "x-volatility": "structural"
        },
        "intent_label": {
          "type": "string",
          "description": "Reserved: business intent label. Not filled in V1 (a job for the language-model proposer, to be added after V1)."
        },
        "description": {
          "type": "string",
          "description": "Reserved: natural-language description. Not filled in V1."
        },
        "status": {
          "type": "string",
          "enum": ["candidate", "grounded", "validation_failed", "inconclusive"],
          "description": "Four states (decision record 007 D49/D51 + 010 D63): candidate = validation not yet attempted; grounded = end-to-end replay passed; validation_failed = validly executed and refuted; inconclusive = validation was attempted but not completed validly for tool/environment reasons. The 'candidate + reported reason' of 009 was a transitional expression; inconclusive is formally in effect since 010."
        },
        "x-carverflow-runtime-ranking": {
          "$ref": "#/$defs/runtime_ranking_extension",
          "description": "Read-only ranking / risk annotation for this skill from the Runtime Material Phase 2 sidecar. The extension does not change steps / bindings / parameters / status and does not extend the Stage 5 candidate space."
        }
      },
      "additionalProperties": false
    },
    "runtime_evidence_ref": {
      "type": "object",
      "required": ["source", "reason"],
      "properties": {
        "source": { "type": "string" },
        "material_id": { "type": ["string", "null"] },
        "edge_id": { "type": ["string", "null"] },
        "hypothesis_id": { "type": ["string", "null"] },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "runtime_conflict_ref": {
      "type": "object",
      "required": ["conflict_id", "conflict_type", "scope", "operations", "explanation"],
      "properties": {
        "conflict_id": { "type": "string" },
        "conflict_type": { "type": "string" },
        "scope": { "type": "string" },
        "operations": { "type": "array", "items": { "type": "string" } },
        "explanation": { "type": "string" }
      },
      "additionalProperties": false
    },
    "runtime_ranking_policy": {
      "type": "object",
      "required": [
        "status_unchanged",
        "steps_unchanged",
        "bindings_unchanged",
        "parameters_unchanged",
        "does_not_set_grounded",
        "does_not_expand_candidates",
        "does_not_reorder_stage5_output"
      ],
      "properties": {
        "status_unchanged": { "const": true },
        "steps_unchanged": { "const": true },
        "bindings_unchanged": { "const": true },
        "parameters_unchanged": { "const": true },
        "does_not_set_grounded": { "const": true },
        "does_not_expand_candidates": { "const": true },
        "does_not_reorder_stage5_output": { "const": true }
      },
      "additionalProperties": false
    },
    "runtime_ranking_extension": {
      "type": "object",
      "required": [
        "phase",
        "report_ref",
        "annotation_id",
        "matched_sequence_id",
        "matched_lifecycle_hypotheses",
        "suggested_score",
        "suggested_rank",
        "dominant_evidence",
        "dominant_risk",
        "matched_materials",
        "positive_evidence",
        "negative_evidence",
        "conflicts",
        "policy"
      ],
      "properties": {
        "phase": { "const": "phase2_sidecar" },
        "report_ref": { "type": "string", "minLength": 1 },
        "annotation_id": { "type": "string", "minLength": 1 },
        "matched_sequence_id": { "type": ["string", "null"] },
        "matched_lifecycle_hypotheses": {
          "type": "array",
          "items": { "type": "string" }
        },
        "suggested_score": { "type": "number", "minimum": 0, "maximum": 100 },
        "suggested_rank": { "type": "integer", "minimum": 1 },
        "dominant_evidence": { "type": "string" },
        "dominant_risk": { "type": "string", "enum": ["low", "medium", "high", "blocked"] },
        "matched_materials": {
          "type": "array",
          "items": { "type": "string" }
        },
        "positive_evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/runtime_evidence_ref" }
        },
        "negative_evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/runtime_evidence_ref" }
        },
        "conflicts": {
          "type": "array",
          "items": { "$ref": "#/$defs/runtime_conflict_ref" }
        },
        "policy": { "$ref": "#/$defs/runtime_ranking_policy" }
      },
      "additionalProperties": false
    }
  }
}
