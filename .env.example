# Copy to .env and `set -a; source .env; set +a` before level-2/3 commands.
# Every value below is a local placeholder: the subjects run on 127.0.0.1, are reset from their seed state
# before every validation run, and hold no real data. The adapters and profiles only ever name the variables.
# Package root and interpreter (the adapters spawn reset/launch commands with these)
UISEMTEST_REPO_ROOT=<ARTIFACT_ROOT>
UISEMTEST_PYTHON=<ARTIFACT_ROOT>/.venv/bin/python
UISEMTEST_OPERATOR_PATH=/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin   # PATH for docker/psql/curl inside adapter commands
# Conduit (deployed with deploy/conduit; the values below are the local placeholders used in the study)
UISEMTEST_CONDUIT_DEPLOY_ROOT=<ARTIFACT_ROOT>/deploy/conduit
UISEMTEST_CONDUIT_OUTPUT_ROOT=<ARTIFACT_ROOT>/eval/ui_semantics/reviewer-runtime/conduit
UISEMTEST_CONDUIT_ACTOR_A_USERNAME=carver
UISEMTEST_CONDUIT_ACTOR_A_EMAIL=carver@carverflow.local
UISEMTEST_CONDUIT_ACTOR_A_PASSWORD=carverflow-test-pw
UISEMTEST_CONDUIT_ACTOR_B_USERNAME=uisemtest_actor_b
UISEMTEST_CONDUIT_ACTOR_B_EMAIL=actor-b@carverflow.local
UISEMTEST_CONDUIT_ACTOR_B_PASSWORD=uisemtest-local-b
# RWA (cypress-realworld-app checkout at commit bdf6169; seeded users)
UISEMTEST_RWA_CHECKOUT=<SUBJECTS>/cypress-realworld-app
UISEMTEST_NODE22_BIN=/usr/local/opt/node@22/bin   # directory that contains the Node.js 22 `node` binary
UISEMTEST_RWA_ACTOR_A_USERNAME=Heath93
UISEMTEST_RWA_ACTOR_A_PASSWORD=s3cret
UISEMTEST_RWA_ACTOR_B_USERNAME=Arvilla_Hegmann
UISEMTEST_RWA_ACTOR_B_PASSWORD=s3cret
# Umami (deploy/umami; run deploy/umami/db_up.sh before the first supervise; app on 127.0.0.1:18090)
UISEMTEST_UMAMI_DEPLOY_ROOT=<ARTIFACT_ROOT>/deploy/umami
UISEMTEST_UMAMI_OUTPUT_ROOT=<ARTIFACT_ROOT>/eval/ui_semantics/reviewer-runtime/umami
UISEMTEST_UMAMI_APP_SECRET=uisemtest-local-umami-secret
UISEMTEST_UMAMI_ACTOR_A_USERNAME=admin
UISEMTEST_UMAMI_ACTOR_A_PASSWORD=uisemtest-local-umami-a
UISEMTEST_UMAMI_ACTOR_B_USERNAME=uisemtest_actor_b
UISEMTEST_UMAMI_ACTOR_B_PASSWORD=uisemtest-local-umami-b
# Paperless-ngx (deploy/paperless; sidecars via deploy/paperless/stack.sh sidecars-up; app on 127.0.0.1:18091)
UISEMTEST_PAPERLESS_OUTPUT_ROOT=<ARTIFACT_ROOT>/eval/ui_semantics/reviewer-runtime/paperless
UISEMTEST_PAPERLESS_SECRET_KEY=uisemtest-local-paperless-secret
UISEMTEST_PAPERLESS_DBPASS=uisemtest-local-paperless-db
UISEMTEST_PAPERLESS_REDIS_SOCKET=/var/run/redis/redis.sock
UISEMTEST_PAPERLESS_ACTOR_A_USERNAME=admin
UISEMTEST_PAPERLESS_ACTOR_A_PASSWORD=uisemtest-local-paperless-a
UISEMTEST_PAPERLESS_ACTOR_B_USERNAME=uisemtest_actor_b
UISEMTEST_PAPERLESS_ACTOR_B_PASSWORD=uisemtest-local-paperless-b
# Paperless reset switches (both default to off; see deploy/paperless/README.md)
# UISEMTEST_PAPERLESS_RESET_SKIP_CACHE=0
# UISEMTEST_PAPERLESS_RESET_SKIP_FILES=0
# Ghost (deploy/ghost; single container with SQLite, app on 127.0.0.1:18093; see deploy/ghost/env.example)
UISEMTEST_GHOST_OUTPUT_ROOT=<ARTIFACT_ROOT>/eval/ui_semantics/reviewer-runtime/ghost
UISEMTEST_GHOST_RUNTIME_ROOT=/tmp/uisemtest-ghost   # content directory and golden snapshot; must be OUTSIDE the package
UISEMTEST_GHOST_SITE_TITLE=UISemTest-Ghost
UISEMTEST_GHOST_ACTOR_A_NAME=ActorA
UISEMTEST_GHOST_ACTOR_A_EMAIL=actora@ghost.invalid
UISEMTEST_GHOST_ACTOR_A_PASSWORD=uisemtestlocalghostactora01
UISEMTEST_GHOST_ACTOR_B_NAME=ActorB
UISEMTEST_GHOST_ACTOR_B_EMAIL=actorb@ghost.invalid
UISEMTEST_GHOST_ACTOR_B_PASSWORD=uisemtestlocalghostactorb01
UISEMTEST_GHOST_ACTOR_B_ROLE=Author
# UISEMTEST_GHOST_BASE_URL=http://127.0.0.1:18093
# UISEMTEST_GHOST_CONTAINER_PREFIX=uisemtest-ghost
# UISEMTEST_GHOST_READY_TIMEOUT_S=120
# Level 3 only
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
